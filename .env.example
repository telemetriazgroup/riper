# Copiar a .env y ajustar valores.

# Docker Compose: puerto publicado del Nginx (host → contenedor 80)
WEB_PORT=18080

# --- Build Vite (embebido en el bundle: obligatorio rehacer `docker compose build app` al cambiar) ---

# Raíz de la app en el navegador:
# - "/" si sirves en http://IP:18080/ sin subpath
# - "/madurador/" si la URL pública es https://ztrack.app/madurador/ (ver docs/deploy-ztrack-madurador.md)
VITE_BASE_PATH=/

# API Ripener (login, usuarios). Debe alinearse con VITE_BASE_PATH:
# - Raíz: /ripener-api
# - Subpath madurador: /madurador/ripener-api
VITE_RIPENER_API_URL=/ripener-api

# API TermoKing (telemetría): URL que usará el navegador en runtime
VITE_API_BASE_URL=http://localhost:9055

# --- Solo desarrollo (pnpm dev): proxy Vite → TermoKing ---
VITE_API_PROXY_TARGET=http://localhost:9055

# Proxy Ripener en dev (pnpm dev): por defecto API en :4000
VITE_RIPENER_API_PROXY_TARGET=http://localhost:4000

# Cuenta demo demo-flota@riper.local: el front llama a Ripener /api/v1/madurador-demo/…;
# el api reenvía a MADURADOR_DEMO_API_BASE (equivalente a
# http://161.132.53.51:9051/Madurador/listar_dispositivos_proceso_identificador_empresa/?identificador=2001
# y buscar_datos bajo /Madurador/…)
# MADURADOR_DEMO_API_BASE=http://161.132.53.51:9051
# Vite (pnpm dev) proxy: destino de /madurador-demo → upstream
# VITE_MADURADOR_DEMO_PROXY_TARGET=http://161.132.53.51:9051
# VITE_MADURADOR_DEMO_API_URL=/ripener-api/api/v1/madurador-demo
# VITE_FLEET_DEMO_IDENTIFICADOR=2001

# --- Ejemplo producción ztrack.app/madurador/ (descomentar y usar en .env real) ---
# VITE_BASE_PATH=/madurador/
# VITE_RIPENER_API_URL=/madurador/ripener-api

# --- API Docker (server/) ---
# JWT_SECRET=...   # obligatorio en producción
# SUPERUSER_EMAIL=superadmin@riper.local
# SUPERUSER_PASSWORD=changeme123
# URL base API Madurador (solo servidor; proxy GET /api/v1/madurador/dispositivos)
# Ej. local: http://localhost:9059  (listar dispositivos ?identificador=… según el usuario, p. ej. ultraorganics@riper.local → 2001)
# MADURADOR_API_BASE=http://161.132.53.51:9051
# JWT superadmin solo: fusión lista Madurador (empresa amplia + equipo pin)
# SUPERUSER_MADURADOR_WIDE_EMPRESA_IDENTIFICADOR=2001
# SUPERUSER_MADURADOR_EMPRESA_IDENTIFICADOR=3001
# SUPERUSER_DEVICE_IMEI=PRUEBA_CA000001
# Todas las filas empresa 3001: SUPERUSER_DEVICE_IMEI=*
# Tercera fusión superadmin — empresa 4001 (Greenyard), lista completa; desactivar: SUPERUSER_MADURADOR_GREENYARD_IDENTIFICADOR=NONE
# SUPERUSER_MADURADOR_GREENYARD_IDENTIFICADOR=4001
# Cuarta fusión superadmin — empresa 5001, lista completa; desactivar: SUPERUSER_MADURADOR_5001_IDENTIFICADOR=NONE
# SUPERUSER_MADURADOR_5001_IDENTIFICADOR=5001
# Compatibilidad: MADURADOR_SUPERADMIN_IDENTIFICADOR reemplaza a SUPERUSER_MADURADOR_EMPRESA_IDENTIFICADOR si la segunda no existe
# ULTRAORGANICS_DEMO_PASSWORD=...  # si usas el usuario sembrado en seed

# Demo ThermoKing (un solo equipo, empresa upstream 3001 + IMEI pin)
# THERMOKING_EMAIL=thermoking@riper.local
# THERMOKING_PASSWORD=thermoking2026!
# THERMOKING_DEVICE_IMEI=PRUEBA_CA000001
# THERMOKING_EMPRESA_IDENTIFICADOR=3001
# En el front (rebuild Docker si cambias): VITE_THERMOKING_EMAIL, VITE_THERMOKING_DEVICE_IMEI

# Demo Gourmet Trading (Madurador identificador 5001; solo IMEI pin abajo; rol admin)
# GOURMET_TRADING_EMAIL=gourmettrading@ztrack.app
# GOURMET_TRADING_PASSWORD='@gourmet2026!'
# GOURMET_TRADING_SYNC_PASSWORD=1
# GOURMET_TRADING_IDENTIFICADOR=5001
# GOURMET_TRADING_DEVICE_IMEIS=867856038562796,866262036100104
# VITE_GOURMET_TRADING_EMAIL=gourmettrading@ztrack.app
# VITE_GOURMET_TRADING_DEVICE_IMEIS=867856038562796,866262036100104

# Demo Greenyard (empresa upstream 4001; todos los IMEI por defecto; opcional filtro «solo normal» abajo)
# GREENYARD_EMAIL=greenyard@riper.local
# GREENYARD_PASSWORD=greenyard2026!
# GREENYARD_IDENTIFICADOR=4001
# GREENYARD_FILTER_NORMAL_OPERATION=1
# VITE_GREENYARD_EMAIL=greenyard@riper.local
# --- Grupo túnel (Gourmet): por defecto el cliente usa Ripener GET /api/v1/tunel/grupo (proxy a :9051, sin CORS).
# Solo definir VITE_TUNEL_GRUPO_URL si quieres llamar al Unidos desde el navegador (requiere CORS en :9051):
# VITE_TUNEL_GRUPO_URL=http://161.132.53.51:9051/Unidos/leer_grupo_tunel/?grupo=TUNEL_GREAT
# Dev alternativo: proxy Vite /tunel-api (vite.config.ts) + VITE_TUNEL_GRUPO_URL=/tunel-api/Unidos/leer_grupo_tunel/?grupo=TUNEL_GREAT
# Servidor Ripener: misma base que madurador (MADURADOR_API_BASE) para el upstream Unidos
