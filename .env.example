# Copiar a .env y ajustar valores.

# Docker Compose: puerto del Nginx que sirve el front (host → contenedor 80). Si 18080 está ocupado:
# WEB_PORT=19000
WEB_PORT=18080
# La API puede tener otra IP/host; configurar aquí evita CORS en desarrollo.

# URL base que usa el frontend para llamar a la API TermoKing.
# - URL completa: el navegador llama directo a esa IP (la API debe permitir CORS).
# - /api: en desarrollo Vite hace proxy a VITE_API_PROXY_TARGET (evita CORS).
VITE_API_BASE_URL=http://localhost:9055

# Solo aplica en desarrollo cuando VITE_API_BASE_URL=/api.
# URL real del backend; el proxy reenvía /api/* hacia aquí.
# Ejemplo si la API está en otra máquina: http://192.168.1.10:9055
VITE_API_PROXY_TARGET=http://localhost:9055

# Ruta base del front (solo afecta al build). Por defecto "/" (dominio raíz, ej. ztrack.app).
# Si la app se sirve en un subpath (ej. somos.com/beta_ripener), definir:
# VITE_BASE_PATH=/beta_ripener/

# --- API Ripener (módulo usuarios, PostgreSQL vía backend en server/) ---
# Desarrollo con Vite: mismo origen; el proxy envía /ripener-api → backend (puerto 4000).
VITE_RIPENER_API_URL=/ripener-api
# Destino del proxy (solo desarrollo). Con `docker compose up -d db api` el API escucha en 4000.
VITE_RIPENER_API_PROXY_TARGET=http://localhost:4000

# --- API (Docker / server/) — login y JWT ---
# JWT_SECRET=...   # obligatorio en producción (cadena larga aleatoria)
# SUPERUSER_EMAIL=superadmin@riper.local
# SUPERUSER_PASSWORD=changeme123
